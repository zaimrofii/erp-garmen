      "fitur_utama": "Kemampuan/fitur andalan dari model tersebut"
    },
    "catatan_teknis": {
      "relasi": "Tanda 'Many2one', 'One2many', 'Many2many' menunjukkan relasi antar model",
      "compute": "Field yang nilainya dihitung otomatis oleh sistem (bukan disimpan langsung)",
      "related": "Field yang mengambil nilai dari field di model lain (mirip pointer)",
      "store": "Field yang nilainya disimpan di database (default True)"
    },
    "konvensi_penamaan": {
