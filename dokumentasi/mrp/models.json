{
  "panduan_baca": {
    "tujuan": "Dokumen ini merangkum konsep dasar modul MRP (Manufacturing) di Odoo, mencakup Bill of Material, Manufacturing Order, Work Order, dan Unbuild Order.",
    "10_konsep_dasar": [
      "Manufacturing Order (MO) = order produksi utama. Statusnya: draft → confirmed → progress → to_close → done.",
      "Bill of Material (BOM) = resep produk: daftar komponen (bahan baku) + by-products + operasi/routing.",
      "BOM bisa multi-level (sub-BOM) dan phantom (kit) yang di-explode ke komponennya.",
      "Work Order (WO) = instansi operasi pada MO spesifik. Satu MO bisa punya banyak WO.",
      "Workcenter = mesin/unit produksi dengan kapasitas, biaya, dan kalender kerja.",
      "Dependensi WO: WO A harus selesai dulu sebelum WO B bisa dimulai.",
      "Reservasi komponen = proses lock stock untuk MO (action_assign).",
      "Consumption policy: flexible (boleh beda), warning (warning), strict (block).",
      "Unbuild = kebalikan dari MO: bongkar produk jadi menjadi komponen.",
      "By-product = produk sampingan dari produksi dengan cost share (% biaya produksi)."
    ]
  },

