# ============================================================
# Contoh environment Django app `garmen` (copy ke `.env`)
#   cp django_app/.env.example django_app/.env
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# Database (Postgres yang sama dengan Odoo, DB terpisah)
# NB: nama service Postgres di docker-compose.yml project ini adalah `db`
#     (bukan `postgres`), jadi DB_HOST = db.
DB_NAME=garmen_django
DB_USER=odoo
DB_PASSWORD=odoo
DB_HOST=db
DB_PORT=5432

# Redis
# Dari dalam docker network semua service memakai host `redis` port 6379.
# Dari host, port yang di-publish docker-compose adalah 6380 (6379 sudah
# dipakai redis-server native WSL).
REDIS_URL=redis://redis:6379/0

# Adapter ERP: "odoo" (JSON-RPC ke Odoo) atau "null" (tanpa Odoo, untuk testing)
ERP_ADAPTER=odoo

# Odoo (akses lewat hostname service docker, BUKAN localhost)
ODOO_URL=http://odoo:8069
ODOO_DB=garmen_db
ODOO_USER=api_bot
ODOO_API_KEY=change-me
ODOO_TIMEOUT=30

# Printer thermal ESC/POS (Fase 5 / H5.7 — halaman Settings → Printer)
# Backend cetak: "mock" (dev/test, default) | "usb" (stub: butuh python-escpos +
# libusb) | "network" (TCP raw, umumnya port 9100).
PRINTER_BACKEND=mock
# Wajib bila PRINTER_BACKEND=usb.
PRINTER_USB_VENDOR_ID=
PRINTER_USB_PRODUCT_ID=
# Wajib bila PRINTER_BACKEND=network (host + port 1..65535).
PRINTER_NETWORK_HOST=
PRINTER_NETWORK_PORT=
# Folder hasil "cetak" backend mock (di /tmp supaya tidak masuk repo).
PRINTER_MOCK_DIR=/tmp/print_mock

# CORS — daftar origin frontend yang diizinkan (JANGAN dihapus; tambahkan bila perlu).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# F1.5 (dev): izinkan cookie `sessionid`/`csrftoken` lintas origin ke frontend dev.
# Wajib `True` kalau frontend mengirim `credentials: "include"` (api-client D5);
# pada produksi satu-domain biarkan default (False).
CORS_ALLOW_CREDENTIALS=<True|False>
# Origin yang boleh memakai CSRF cookie. Django menolak POST lintas origin yang
# origin-nya tidak terdaftar di sini (403 "Origin checking failed").
CSRF_TRUSTED_ORIGINS=<http://localhost:5173,http://127.0.0.1:5173>

VITE_WS_ENABLED=true
VITE_WS_URL=ws://localhost:8000
