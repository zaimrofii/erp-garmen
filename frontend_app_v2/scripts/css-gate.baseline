# Baseline gate CSS (no visual regression) — dibaca scripts/css-gate.sh.
#
# md5   = md5sum dist/assets/index-*.css SETELAH `bun --bun run build`.
# rules = jumlah blok rule ({) di file CSS yang sama, dihitung PERSIS seperti
#         scripts/css-gate.sh (tr '}' '\n' | grep -c '{') — bukan jumlah selektor.
#
