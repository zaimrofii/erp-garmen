# ============================================================
# F3-B.2.1 — TEMPLATE env PRODUCTION (backend)
#
#   cp .env.prod.example .env.prod     # lalu ISI NILAI NYATA (jangan commit)
#
# Dipakai oleh: docker compose -f docker-compose.prod.yml
#   * service `django`/`celery_*`  -> semua variabel DJANGO_*/DB_*/ODOO_*/dst
#   * service `postgres`           -> hanya POSTGRES_DB/USER/PASSWORD
#
# Format: KEY=value (tanpa tanda kutip). Jangan ada spasi di sekitar `=`.
# Nilai `__...__` = PLACEHOLDER, WAJIB diganti sebelum deploy.
# ============================================================

# --- Django core -----------------------------------------------------------
# Ambil dari: openssl rand -hex 32   (WAJIB unik per klien; JANGAN pakai dev key)
DJANGO_SECRET_KEY=__GENERATE_WITH_openssl_rand_hex_32__
# Ambil dari: selalu False di produksi (settings default juga False)
DJANGO_DEBUG=False
# Ambil dari: domain publik yang dipakai (dipisah koma bila lebih dari satu)
DJANGO_ALLOWED_HOSTS=mes.klien-a.com
# Ambil dari: kesepakatan lokasi pabrik (default settings: Asia/Jakarta)
DJANGO_TIME_ZONE=Asia/Jakarta
# Ambil dari: kebijakan log klien (INFO = produksi normal)
DJANGO_LOG_LEVEL=INFO

# --- Database (Django) -----------------------------------------------------
# Ambil dari: nama DB yang ingin dipakai (mis. garmen_django)
DB_NAME=garmen_django
# Ambil dari: user Postgres khusus aplikasi (JANGAN pakai `odoo` superuser)
DB_USER=__CHANGE_ME__
# Ambil dari: password acak user di atas (mis. openssl rand -base64 24)
DB_PASSWORD=__CHANGE_ME__
# Ambil dari: nama service Postgres di compose ini (JANGAN localhost)
DB_HOST=postgres
# Ambil dari: port default Postgres
DB_PORT=5432
# Ambil dari: tuning koneksi (settings default 60 detik)
DB_CONN_MAX_AGE=60
# Ambil dari: timeout koneksi awal (settings default 5 detik)
DB_CONNECT_TIMEOUT=5

# --- Database (image `postgres`) — HARUS SAMA dengan DB_* di atas ----------
# Ambil dari: salin nilai DB_* ke tiga baris ini (image postgres baca POSTGRES_*)
POSTGRES_DB=garmen_django
POSTGRES_USER=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Redis (cache + celery broker + channel layer) -------------------------
# Ambil dari: nama service redis di compose ini, port 6379, db 0
REDIS_URL=redis://redis:6379/0

# --- Adapter ERP -----------------------------------------------------------
# Ambil dari: `odoo` untuk produksi (atau `null` untuk mode tanpa Odoo)
ERP_ADAPTER=odoo
# Ambil dari: base URL Odoo EKSTERNAL klien (bukan service docker lokal)
ODOO_URL=https://erp.klien-a.com
# Ambil dari: nama database Odoo klien
ODOO_DB=garmen_db
# Ambil dari: user Odoo khusus integrasi (bukan admin)
ODOO_USER=api_bot
# Ambil dari: API key user Odoo di atas (Odoo > Preferences > API Keys)
ODOO_API_KEY=__CHANGE_ME__
# Ambil dari: timeout JSON-RPC Odoo (settings default 30 detik)
ODOO_TIMEOUT=30

# --- Pemetaan ID Odoo (integer; SANGAT spesifik per database klien) --------
# Ambil dari: Odoo UI, buka model stock.location lalu baca kolom ID
ODOO_LOCATION_PRODUCTION_ID=__CHANGE_ME__
ODOO_LOCATION_FG_ID=__CHANGE_ME__
ODOO_LOCATION_WIP_ID=__CHANGE_ME__
ODOO_LOCATION_SCRAP_ID=__CHANGE_ME__
# Ambil dari: Odoo UI, model uom.uom (default "Units" biasanya 33)
ODOO_UOM_ID=33

# --- CORS / CSRF (frontend satu domain) ------------------------------------
# Ambil dari: origin frontend produksi (skema https, tanpa trailing slash)
CORS_ALLOWED_ORIGINS=https://mes.klien-a.com
# Ambil dari: origin yang boleh kirim cookie CSRF (harus https)
CSRF_TRUSTED_ORIGINS=https://mes.klien-a.com
# Ambil dari: True bila frontend mengirim cookie lintas origin (satu domain: bebas)
CORS_ALLOW_CREDENTIALS=True

# --- Keamanan TLS (F3-B.2.2 — aktif saat DEBUG=False, Nginx terminasi TLS) --
# Blok `SECURE_*` di settings.py menyala otomatis saat DEBUG=False (bukan mode test).
# Ambil dari: True karena TLS diterminasi di Nginx (redirect http->https)
SECURE_SSL_REDIRECT=True
# Ambil dari: True agar Django percaya header X-Forwarded-Proto dari Nginx
#             (WAJIB True, kalau tidak: redirect loop Nginx<->Django)
DJANGO_SECURE_PROXY_SSL_HEADER=True
# Ambil dari: True (cookie sesi hanya boleh lewat HTTPS)
SESSION_COOKIE_SECURE=True
# Ambil dari: True (cookie CSRF hanya boleh lewat HTTPS)
CSRF_COOKIE_SECURE=True
# Ambil dari: 31536000 = 1 tahun. Saat uji awal pakai nilai kecil (mis. 300) dulu!
SECURE_HSTS_SECONDS=31536000
# Ambil dari: True bila seluruh subdomain juga HTTPS
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Ambil dari: False sampai domain benar-benar siap masuk preload list browser
SECURE_HSTS_PRELOAD=False

# --- Opsional (biarkan default bila tidak dipakai) -------------------------
# Ambil dari: kebijakan retensi hasil tugas (settings default 3600 detik)
CELERY_RESULT_EXPIRES=3600
# Ambil dari: nomor WA penerima alert rekonsiliasi (kosong = nonaktif)
RECONCILIATION_ALERT_WA_TO=

# --- Nginx / Certbot (F3-B.2.2) --------------------------------------------
# Ambil dari: domain publik aplikasi — HARUS sama dengan `server_name` di
#             `nginx/conf.d/mes.conf` dan path cert `/etc/letsencrypt/live/<DOMAIN>/`
DOMAIN=mes.klien-a.com
# Ambil dari: email operator (notifikasi kedaluwarsa Let's Encrypt)
LETSENCRYPT_EMAIL=__CHANGE_ME__

# --- Frontend build (build-ARG untuk frontend_app_v2/Dockerfile) -----------
# Dipakai service `frontend_builder`; harus SAME-ORIGIN dengan domain di atas.
# Ambil dari: https://<domain>/api/v1
VITE_API_BASE_URL=https://mes.klien-a.com/api/v1
# Ambil dari: wss://<domain>/ws (event bus /ws/events/)
VITE_WS_URL=wss://mes.klien-a.com/ws

# --- Backup (F3-B.2.3 — service `backup` & scripts/backup.sh) --------------
# Ambil dari: folder penyimpanan di HOST (relatif ke root project). Di dalam
#             container `backup` nilai ini di-override jadi /backup oleh compose.
BACKUP_DIR=./backups
# Ambil dari: kebijakan retensi klien (harian 7 hari = baseline; naikkan bila perlu)
RETENTION_DAYS=7
# Ambil dari: interval loop service `backup` dalam detik (86400 = sekali sehari)
BACKUP_INTERVAL_SECONDS=86400

# --- Monitoring: Sentry (F3-B.2.3 — OPSIONAL) ------------------------------
# Ambil dari: Sentry > Project > Settings > Client Keys (DSN). KOSONG = nonaktif.
SENTRY_DSN=
# Ambil dari: label lingkungan yang muncul di dashboard Sentry
SENTRY_ENVIRONMENT=production
# Ambil dari: versi rilis (SHA commit / tag). Boleh kosong.
SENTRY_RELEASE=
# Ambil dari: 0.0 = tracing mati (hemat kuota); 0.1 = 10% transaksi
SENTRY_TRACES_SAMPLE_RATE=0.0
# Ambil dari: True HANYA bila boleh mengirim data pribadi (umumnya False)
SENTRY_SEND_DEFAULT_PII=False
